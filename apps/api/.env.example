# Annaadhya API — example environment (placeholders only; never commit real secrets)
# Every variable below is read by apps/api/src/config/env.ts (Zod-validated at boot)
# unless noted otherwise.
#
# TOPOLOGY: each app now runs on its OWN domain (no platform same-origin rewrite),
# so browser calls from the storefront/admin hit this API cross-origin — CORS_ORIGINS
# below is what makes that work. Replace every REPLACE-ME domain with the real one.

# Hostinger injects NODE_ENV=production and PORT into the runtime; the two lines
# below are for local runs. On the platform you can leave both unset.
NODE_ENV=production
PORT=4000

# Browser origins allowed to call this API cross-origin. Scheme + host only —
# NO trailing slash, NO path. List the storefront AND admin domains, comma-separated.
# Server-to-server calls (storefront server components, webhooks) are NOT affected
# by CORS — only browsers are.
# REPLACE-ME with your real storefront + admin origins.
CORS_ORIGINS=https://annaadhya.com,https://admin.annaadhya.com

# Data provider: memory (mock, dev only — boot-throws in production) | firestore
DATA_PROVIDER=firestore

# Firebase Admin SDK (service account) — REQUIRED in production (the API refuses to
# boot with NODE_ENV=production and any of them missing). Create at: Firebase console →
# Project settings → Service accounts → Generate new private key.
# FIREBASE_PRIVATE_KEY format: keep the FULL key on ONE line inside double quotes with
# literal \n escapes — the code converts them to real newlines
# (packages/data-core/src/firestore.provider.ts: FIREBASE_PRIVATE_KEY.replace(/\\n/g, "\n")).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Optional: only if you created a NAMED Firestore database (not the "(default)").
FIRESTORE_DATABASE_ID=

# Mock-mode dev tokens (POST /auth/v1 dev sign-in). Dev/test only — the endpoint refuses
# whenever Firebase credentials exist or NODE_ENV=production. Min 16 chars.
# Generate: openssl rand -hex 32
DEV_TOKEN_SECRET=

# One-time owner bootstrap guard for POST /api/v1/auth/bootstrap-owner (min 8 chars).
# Needed to create the first admin owner. The endpoint refuses once an owner exists, but
# rotate this value afterwards anyway. Generate: openssl rand -hex 32
ADMIN_SETUP_KEY=

# Payments — Razorpay Standard Checkout.
# ACTIVATION: online payments switch to Razorpay automatically as soon as
# RAZORPAY_KEY_ID + RAZORPAY_KEY_SECRET are present in this environment — no
# other flag is required. Without them, checkout refuses gateway orders in
# production (503) and uses the simulated demo gateway in local mock-mode development.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional — ONLY needed for the push webhook endpoint
# POST /api/v1/payments/webhook/razorpay (payment.captured / payment.failed /
# refund.processed). The standard checkout handshake verifies every payment
# server-side without it (HMAC-SHA256 of order_id|payment_id with the key
# secret). Set this when you configure the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=
# Legacy display flag, kept for compatibility — the platform-status payment
# mode now derives from whether the Razorpay keys above exist.
PAYMENT_PROVIDER=mock

# HMAC secret for the signed mock webhook POST /api/v1/payments/webhook/mock
# (read directly in apps/api/src/modules/payments/mock.provider.ts). Optional — a default
# dev value exists — but set a strong one: openssl rand -hex 32
MOCK_WEBHOOK_SECRET=

# Media (Cloudinary). Optional for the first deployment; required for product image
# uploads through the admin panel. The API uses signed direct uploads — the secret is
# server-side only. Console: Cloudinary dashboard → Settings → Access Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Behaviour tuning (defaults shown; ranges enforced by Zod)
CHECKOUT_QUOTE_TTL_MINUTES=15
STOCK_RESERVATION_TTL_MINUTES=30
EXPORT_SYNC_ROW_LIMIT=20000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=240

# Storefront cache revalidation (optional). When both are set, CMS saves (pages,
# navigation, homepage, categories) push an on-demand revalidation to the
# storefront so changes appear within seconds instead of the 30-120s ISR TTL.
#   STOREFRONT_REVALIDATE_URL     the storefront's revalidate endpoint —
#                                 https://REPLACE-ME-storefront-domain/revalidate
#   STOREFRONT_REVALIDATE_SECRET  any long random string; must EXACTLY match the
#                                 REVALIDATE_SECRET set on the storefront app.
#                                 Generate: openssl rand -hex 32
STOREFRONT_REVALIDATE_URL=https://annaadhya.com/revalidate
STOREFRONT_REVALIDATE_SECRET=
