# Annaadhya Storefront — example environment (placeholders only; never commit real secrets)
# All values below are read by actual code:
#   API_URL                 → apps/storefront/src/lib/api.ts (server components)
#   NEXT_PUBLIC_API_URL     → apps/storefront/src/lib/api.ts (browser calls)
#   NEXT_PUBLIC_SITE_URL    → src/app/layout.tsx, sitemap.ts, robots.ts
#   NEXT_PUBLIC_FIREBASE_*  → apps/storefront/src/lib/auth.tsx (Firebase JS SDK, lazy-loaded)
#   REVALIDATE_SECRET       → src/app/revalidate/route.ts (on-demand cache busting)
#
# TOPOLOGY: this app now runs on its OWN domain and the API on ANOTHER domain
# (no platform same-origin rewrite) — so BOTH API pointers below must be set to
# the API's real domain. Replace every REPLACE-ME domain with the real one.

# Server-side API base (server components fetch the catalogue directly from the API).
# The API's ORIGIN — a trailing /api/v1 is tolerated and normalized (lib/api.ts strips
# it before appending /api/v1).
API_URL=https://staging.annaadhya.com

# Browser-side API base. NOW REQUIRED on the separate-domain setup: browsers can no
# longer call a same-origin /api/v1 prefix, so point them at the API's real domain.
NEXT_PUBLIC_API_URL=https://staging.annaadhya.com/api/v1

# Public origin of THIS storefront (metadata/OG, sitemap, robots). Scheme + host only,
# no trailing slash. Note: robots.ts only allows indexing when this starts with https://.
# REPLACE-ME with the storefront's real domain.
NEXT_PUBLIC_SITE_URL=https://annaadhya.com

# Firebase client SDK — enables real sign-in on the storefront (Google + email/password).
# Unset → the UI falls back to honest mock-mode sign-in (development only).
# Values come from: Firebase console → Project settings → General → Your apps →
# Web app → SDK setup and configuration (the firebaseConfig object).
# These are PUBLIC by design (Firebase web keys are not secrets) and are inlined into
# the client bundle at BUILD TIME — they must exist in this app's environment BEFORE
# the platform runs the build, and changing them later requires a redeploy.
# ALSO: add the storefront's real domain to Firebase console → Authentication →
# Settings → Authorized domains, or Google sign-in returns auth/unauthorized-domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Shared secret for on-demand cache revalidation: the API pushes an authenticated
# POST to https://THIS-DOMAIN/revalidate after CMS saves so changes appear within
# seconds instead of the 30-120s ISR TTL. Must EXACTLY match STOREFRONT_REVALIDATE_SECRET
# on the API. When unset the endpoint is disabled (403) and ISR falls back to TTL.
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=
