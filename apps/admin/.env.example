# Annaadhya Admin — environment (placeholders only; never commit real secrets)
#
# TOPOLOGY: this panel now runs on its OWN domain and the API on ANOTHER domain
# (no platform same-origin rewrite) — so the API pointer below must be set to the
# API's real domain. Replace every REPLACE-ME domain with the real one.

# Browser-side API base. NOW REQUIRED on the separate-domain setup: the panel can no
# longer call a same-origin /api/v1 prefix, so point it at the API's real domain
# (global prefix /api/v1 included). Also make sure the admin's origin is listed in
# the API's CORS_ORIGINS, or every browser call dies on the preflight.
NEXT_PUBLIC_API_URL=https://staging.annaadhya.com/api/v1

# Firebase client config — REQUIRED for production sign-in (build-time inlined; set them
# BEFORE building/deploying). Same values as the storefront. When present, the login screen
# renders Firebase sign-in (email/password + Google); the resulting ID token is exchanged at
# POST /auth/verify and used as the session bearer token (the API re-verifies it every call).
# When absent (local mock-mode development), the panel falls back to the dev-token form.
# These are inlined into the client bundle at BUILD TIME — they must exist in this app's
# environment BEFORE the platform runs the build, and changing them later requires a redeploy.
# ALSO: add the admin's real domain to Firebase console → Authentication →
# Settings → Authorized domains, or Google sign-in returns auth/unauthorized-domain.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# NOTE on sign-in availability: /auth/dev/token is refused by the API whenever Firebase
# credentials are configured (or NODE_ENV=production). That is expected in production —
# the Firebase sign-in form takes over. The first owner provisions themselves via
# POST /auth/bootstrap-owner (ADMIN_SETUP_KEY); the login screen shows the account UID
# needed for that call when a signed-in account has no staff record yet.
