# Vercel's function bundler (rolldown) and file tracer do not follow pnpm's
# symlinked node_modules layout — dependencies get externalized and then go
# missing at runtime ("Cannot find module ..."). A hoisted, real-file layout
# (like npm's) makes every dependency resolvable and includable.
node-linker=hoisted

# Managed builders (e.g. Hostinger) set NODE_ENV=production during the install
# step, which makes pnpm skip devDependencies. Every workspace build step needs
# typescript (a devDependency) to run tsc, so the build dies with
# "sh: tsc: command not found". production=false forces devDependencies to
# install regardless of NODE_ENV. Vercel installs devDeps for builds anyway,
# so this is a no-op there.
production=false
